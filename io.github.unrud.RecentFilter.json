{
    "app-id": "io.github.unrud.RecentFilter",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "recent-filter",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--filesystem=xdg-data",
        "--filesystem=home:ro"
    ],
    "modules": [
        {
            "name": "recent-filter",
            "builddir": true,
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/Unrud/recent-filter",
                    "tag": "v0.1.10",
                    "commit": "28ea2e8388e4517dea1d09812b6983fda265961e",
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/Unrud/recent-filter/releases/latest",
                        "tag-query": ".tag_name"
                    }
                }
            ]
        }
    ]
}
